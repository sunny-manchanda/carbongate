# CarbonGate environment variables
# Copy to .env for local development; on Replit these are set as Secrets.

# Groq API key — powers the AI Analyst tab (Tab 5).
# Without it the app still runs; only the analyst is disabled.
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for analysis.
GROQ_MODEL=llama-3.3-70b-versatile
